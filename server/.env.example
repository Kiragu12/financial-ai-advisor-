PORT=4000
CORS_ORIGIN=http://localhost:5274
NODE_ENV=development

# Supabase PostgreSQL connection string
# Supabase dashboard → Settings → Database → Connection string → URI
# Supabase session-mode pooler (port 5432) — supports full SQL including transactions
# Username includes project ref: postgres.[project-ref]
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# At least 32 random characters — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

JWT_EXPIRES_IN=7d
COOKIE_NAME=akiba_token
