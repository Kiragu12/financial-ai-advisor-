# Frontend environment variables for Akiba.
# Copy this file to `.env.local` and fill in real values for your machine.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Base URL of Paul's backend API. Examples:
#   Local:   http://localhost:4000
#   Railway: https://akiba-api.up.railway.app
# When left blank, the Vite dev server proxies /api -> http://localhost:4000
# (see client/vite.config.ts).
VITE_API_BASE_URL=http://localhost:4000
